---
import { estimateRetirementTax, taxYears } from '../lib/retirement-tax';

const years = Object.keys(taxYears).sort().reverse();
const initialYear = years[0];
const example = { income: 600000, pension: 60000, ra: 100000 };
const initial = estimateRetirementTax(example.income, example.pension, example.ra, taxYears[initialYear]);
const rand = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR', maximumFractionDigits: 0 });
const rows = [
  [['total', 'Total annual contributions'], ['limit', 'Annual deduction limit'], ['allowable', 'Total deductible this year']],
  [['taxBefore', 'Income tax with existing contributions'], ['taxAfter', 'Income tax with the extra RA'], ['saved', 'Tax saved by the extra RA']],
  [['effective', 'After-tax cost of the extra RA'], ['discount', 'Tax saving as a share of the extra RA'], ['carried', 'Contributions carried forward']],
] as const;
---
<section class="feature-block calculator-block" id="retirement-tax-benefit">
  <div class="section-intro">
    <p class="section-kicker">Planning tool</p>
    <h2>Retirement Contribution Tax Benefit</h2>
    <p>See how an additional retirement annuity (RA) contribution changes your estimated income tax for the year.</p>
  </div>
  <div class="calculator-shell" data-tax-benefit>
    <div class="calculator-grid">
      <label>
        <span>Annual taxable salary before retirement deductions (R)</span>
        <input type="number" name="income" value={example.income} min="0" step="any" required />
      </label>
      <label>
        <span>Existing retirement fund contributions (R/year)</span>
        <input type="number" name="pension" value={example.pension} min="0" step="any" required />
      </label>
      <label>
        <span>Planned extra RA contribution (R/year)</span>
        <input type="number" name="raContribution" value={example.ra} min="0" step="any" required />
      </label>
      <label>
        <span>South African tax year</span>
        <select name="taxYear">
          {years.map(year => <option value={year}>{Number(year) - 1}/{year.slice(-2)} (March–February)</option>)}
        </select>
      </label>
    </div>
    <p class="meta">Include employer contributions in your existing total. This estimate assumes a full tax year, salary as your only income and an age under 65 at the end of the tax year. It includes the primary rebate and assumes zero other deductions, tax credits or contributions carried in from prior years.</p>
    <p role="status" data-input-error></p>
    <div class="calculator-result">
      {rows.map((row, index) => (
        <div class:list={['result-row', { highlight: index === 1 }]}>
          {row.map(([key, label]) => (
            <div>
              <p class="result-label">{label}</p>
              <p class="result-value" data-tax-output={key}>
                {key === 'discount' ? initial.discount.toFixed(1) + '%' : rand.format(initial[key])}
              </p>
            </div>
          ))}
        </div>
      ))}
      <p class="meta">The deduction is limited to 27.5% of salary in this estimate, up to <span data-annual-cap>{rand.format(taxYears[initialYear].contributionCap)}</span> for the selected tax year. <a href="https://www.sars.gov.za/tax-rates/income-tax/rates-of-tax-for-individuals/">SARS income tax tables</a>.</p>
      <noscript><p>Enable JavaScript to update the example with your own amounts.</p></noscript>
    </div>
  </div>
</section>

<style>
  #retirement-tax-benefit, #retirement-tax-benefit .calculator-shell {
    padding: clamp(.75rem, 2vw, 1.4rem);
  }
  .section-intro h2 {
    margin-block-start: .5rem;
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    line-height: 1.25;
  }
  #retirement-tax-benefit .calculator-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    align-items: end;
  }
  .calculator-grid label { min-width: 0; margin: 0; font-size: .9rem; line-height: 1.4; }
  .calculator-grid :is(input, select) { min-width: 0; width: 100%; }
  #retirement-tax-benefit .calculator-result {
    container-type: inline-size;
    grid-template-columns: minmax(0, 1fr);
    gap: .5rem;
    padding: clamp(.55rem, 1.5vw, 1rem);
  }
  .result-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
    padding: .75rem;
    margin: 0;
    border-radius: .5rem;
  }
  .result-row.highlight { background: var(--sl-color-bg-hover); border: 1px solid var(--sl-color-hairline); }
  .result-row > div { min-width: 0; margin: 0; overflow-wrap: anywhere; }
  .result-label, .meta { font-size: .875rem; line-height: 1.45; }
  .result-value { font-size: 1rem; line-height: 1.35; font-variant-numeric: tabular-nums; }
  [data-input-error]:empty { display: none; }
  @container (max-width: 28rem) {
    .result-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { estimateRetirementTax, taxYears } from '../lib/retirement-tax';

  const root = document.querySelector<HTMLElement>('[data-tax-benefit]');
  if (root) {
    const rand = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR', maximumFractionDigits: 0 });
    const income = root.querySelector<HTMLInputElement>('[name="income"]')!;
    const pension = root.querySelector<HTMLInputElement>('[name="pension"]')!;
    const ra = root.querySelector<HTMLInputElement>('[name="raContribution"]')!;
    const year = root.querySelector<HTMLSelectElement>('[name="taxYear"]')!;
    const annualCap = root.querySelector<HTMLElement>('[data-annual-cap]')!;
    const notice = root.querySelector<HTMLElement>('[data-input-error]')!;
    const outputs = root.querySelectorAll<HTMLElement>('[data-tax-output]');

    function update() {
      const rules = taxYears[year.value];
      annualCap.textContent = rand.format(rules.contributionCap);
      const valid = [income, pension, ra].every(field => field.validity.valid && Number.isFinite(field.valueAsNumber));
      notice.textContent = valid ? '' : 'Enter a value of zero or more in each amount field.';
      const estimate = valid ? estimateRetirementTax(income.valueAsNumber, pension.valueAsNumber, ra.valueAsNumber, rules) : null;
      for (const output of outputs) {
        const key = output.dataset.taxOutput as keyof ReturnType<typeof estimateRetirementTax>;
        if (!estimate) output.textContent = '—';
        else if (key === 'discount') output.textContent = estimate.discount.toFixed(1) + '%';
        else output.textContent = rand.format(estimate[key]);
      }
    }
    root.addEventListener('input', update);
    root.addEventListener('change', update);
    update();
  }
</script>
