---
import { araAgentId as agentId } from '../ara';
---
<section id="ara" aria-labelledby="ara-heading" class="receptionist" data-agent-id={agentId}>
  <h2 id="ara-heading">Ara, AI receptionist</h2>
  {agentId ? (
    <>
      <p>Ara can take down a callback request. You can check every detail before sending it to Erenst.</p>
      <p class="voice-note">ElevenLabs processes what you say or type. Please keep account numbers and financial documents private.</p>
      <button id="ara-call" type="button" hidden>Start voice call</button>
      <button id="ara-chat" type="button" hidden>Type to Ara</button>
      <p id="ara-status" role="status"></p>
      <div id="ara-messages" role="log" aria-label="Conversation with Ara" hidden></div>
      <form id="ara-compose" hidden>
        <label for="ara-input">Your message</label>
        <input id="ara-input" name="message" maxlength="400" autocomplete="off" required />
        <button type="submit">Send message</button>
      </form>
      <noscript><p>Enable JavaScript for voice calls or phone Erenst directly.</p></noscript>
    </>
  ) : <p>Ara is currently unavailable. You can still reach Erenst directly.</p>}
  <a href="#callback-heading">Use the callback form</a>
</section>

<script>
  import { attachReceptionist } from '../scripts/receptionist';
  const panel = document.querySelector<HTMLElement>('#ara');
  const form = document.querySelector<HTMLFormElement>('#callback-form');
  if (panel?.dataset.agentId && form) {
    // Load audio support only on the contact page of a configured site.
    import('@elevenlabs/client').then(({ Conversation }) => {
      attachReceptionist(panel, form, Conversation.startSession);
    }).catch(() => {
      const status = panel.querySelector('#ara-status');
      if (status) status.textContent = 'Voice could not load. You can still use the callback form.';
    });
  }
</script>
