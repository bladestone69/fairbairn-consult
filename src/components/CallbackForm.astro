<section class="callback-form-section" aria-labelledby="callback-heading">
  <h2 id="callback-heading">Request a call back</h2>
  <p>Leave your name and number and I’ll call you. If there’s a time that suits you, add it below.</p>
  <form id="callback-form" method="post" action="/api/callback-request">
    <label for="callback-name">Your name</label>
    <input id="callback-name" name="name" autocomplete="name" maxlength="120" required />
    <label for="callback-phone">Phone number</label>
    <input id="callback-phone" name="phone" type="tel" autocomplete="tel" maxlength="60" required />
    <details class="callback-optional">
      <summary>Add a time, email or message <span>(optional)</span></summary>
      <label for="callback-time">Best time to call</label>
      <input id="callback-time" name="preferred_time" maxlength="120" placeholder="For example, weekday mornings" />
      <label for="callback-email">Email address</label>
      <input id="callback-email" name="email" type="email" autocomplete="email" maxlength="160" />
      <label for="callback-reason">What would you like to discuss?</label>
      <textarea id="callback-reason" name="reason" rows="3" maxlength="400"></textarea>
    </details>
    <div class="callback-trap" aria-hidden="true"><label for="callback-website">Website</label><input id="callback-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <p class="callback-privacy">By sending this form, you ask Erenst to contact you. Please leave out account numbers and financial documents. <a href="/compliance/privacy/">Privacy information</a></p>
    <button type="submit">Request a call back</button>
    <p id="callback-status" role="status"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#callback-form');
  const status = document.querySelector<HTMLElement>('#callback-status');
  if (form && status) {
    form.addEventListener('invalid', (event) => {
      if (event.target instanceof HTMLElement) {
        const details = event.target.closest('details');
        if (details) details.open = true;
      }
    }, true);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      if (!button || button.disabled || !form.reportValidity()) return;
      button.disabled = true;
      status.textContent = 'Sending your request…';
      const fallback = 'Unable to confirm delivery. Please phone or email Erenst directly.';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form)))
        });
        const result = await response.json().catch(() => ({}));
        if (response.ok && result.success) {
          form.reset();
          status.textContent = 'Thank you. Your callback request has been sent.';
        } else {
          status.textContent = result.error || fallback;
        }
      } catch {
        status.textContent = fallback;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
